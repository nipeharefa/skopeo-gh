{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oci-dashboard",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oci-dashboard",
			"database_id": "2c4effaa-83c2-46cd-bf66-6032d6afbf0e",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "OCI_BUCKET",
			"bucket_name": "catetin-container"
		}
	]
}